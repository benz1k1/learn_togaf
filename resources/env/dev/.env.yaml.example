# Copy to .env.yaml and fill in. See .env.yaml in this directory for the documented shape.
fernet:
  key_file: "~/learn_togaf.yaml"        # contains: fernet_key: "<key>"
opengroup:
  username: "<open group account email>"
  password: "<fernet token>"
app: {host: 127.0.0.1, port: 5014}
paths:
  content_dir: "/abs/path/learn_togaf/content"
  sources_dir: "/abs/path/learn_togaf/resources/sources"
  db_path: "/abs/path/learn_togaf/resources/learn_togaf.db"
  log_dir: "/abs/path/learn_togaf/logs"
security: {csrf_secret: "<random string>"}
sources:
  base_url: "https://pubs.opengroup.org/togaf-standard/"
  login_url: "https://pubs.opengroup.org/togaf-standard/"
  delay_seconds: 1.5
  user_agent: "learn_togaf/1.0 (personal study tool)"
anthropic: {api_key: "<fernet token>", model: claude-opus-5, effort: high, batch_size: 20, max_tokens: 8000}
